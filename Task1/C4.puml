@startuml C4_Container
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

Person(businessUser, "Бизнес-пользователь", "Сотрудник клиник, финтеха или других подразделений")

System_Boundary(b2, "Будущее 2.0") {
    
    Container(portal, "Витрина данных", "Web-приложение", "Портал самообслуживания для построения аналитических отчётов")
    Container(apiGateway, "API Gateway / Интеграционная шина 2.0", "Apache Kafka / NGINX / GraphQL", "Маршрутизация запросов и событий между сервисами")
    Container(authService, "Сервис авторизации", "IAM / RBAC", "Контроль доступа к данным и отчётам")
    Container(dataAggregator, "Сервис агрегации данных", "Python / ETL/ELT", "Формирует витрины данных из разных источников")
    
    Container(finDataStore, "Финтех-хранилище", "PostgreSQL / ClickHouse", "Хранение финансовых данных и кредитной истории")
    Container(medDataStore, "Медицинское хранилище", "Data Lake / Parquet", "Обезличенные данные о клиентах и услугах")
    Container(devicesDataStore, "Хранилище данных электроники", "Time Series DB", "Данные с медицинского оборудования")
    Container(legacyDWH, "Legacy DWH", "MS SQL Server 2008", "Историческое хранилище. Используется как источник на этапе миграции")

}

System_Ext(biSystem, "BI-система (Power BI)")
System_Ext(clinicSystems, "Системы клиник")
System_Ext(aiServices, "ИИ-сервисы")
System_Ext(fintechApps, "Финтех-сервисы")

' Взаимодействия
Rel(businessUser, portal, "Просматривает и строит отчёты")
Rel(portal, authService, "Аутентификация и авторизация")
Rel(portal, dataAggregator, "Запрашивает агрегированные данные")
Rel(dataAggregator, finDataStore, "Читает данные")
Rel(dataAggregator, medDataStore, "Читает данные")
Rel(dataAggregator, devicesDataStore, "Читает данные")
Rel(dataAggregator, legacyDWH, "Читает данные (временно)")

Rel(fintechApps, apiGateway, "Обмениваются данными")
Rel(aiServices, apiGateway, "Отправляют/получают данные")

Rel(biSystem, dataAggregator, "Получает витрины для отчётности")

@enduml
